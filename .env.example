# Frontend Convex deployment variables
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=

# Auth0 SPA application (public values)
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=

# Convex auth provider configuration; also set these in the Convex deployment.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=

# Verified Auth0 email permitted to bootstrap the initial administrator.
DWMS_INITIAL_ADMIN_EMAIL=

# Server-side Convex environment variable; never expose this as a VITE_ variable.
OPENAI_API_KEY=
